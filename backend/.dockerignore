.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Postman / generated docs (not needed inside the image)
.postman/
postman/environments/
VetManagerEnv.environment.yaml
schema.yaml

# VCS / build tooling — irrelevant inside the image
.git
.gitignore
Dockerfile
.dockerignore