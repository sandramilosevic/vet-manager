# Byte-compiled / cache
__pycache__/
*.py[codz]
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv
venv/
env/
ENV/

# Django
db.sqlite3
db.sqlite3-journal
*.log
logs/
media/
staticfiles/
